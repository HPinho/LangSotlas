{
  "name": "baken-sotlas",
  "displayName": "Sotlas Language",
  "publisher": "bakenos",
  "description": "Suporte oficial à linguagem Sotlas: realce de sintaxe, LSP, diagnósticos e comandos de compilação",
  "version": "0.3.0",
  "icon": "./icons/sotlas-icon.png",
  "engines": {
    "vscode": "^1.60.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/HPinho/LangSotlas.git"
  },
  "homepage": "https://github.com/HPinho/LangSotlas",
  "keywords": ["sotlas", "baken", "systems", "kernel", "language"],
  "main": "./out/extension.js",
  "activationEvents": [
    "onLanguage:sotlas"
  ],
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "package": "vsce package"
  },
  "contributes": {
    "languages": [
      {
        "id": "sotlas",
        "aliases": [
          "Sotlas",
          "Baken Sotlas",
          "sotlas"
        ],
        "extensions": [
          ".sotlas",
          ".sth"
        ],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./icons/sotlas-icon.svg",
          "dark": "./icons/sotlas-logo.svg"
        }
      }
    ],
    "grammars": [
      {
        "language": "sotlas",
        "scopeName": "source.sotlas",
        "path": "./syntaxes/sotlas.tmLanguage.json"
      }
    ],
    "iconThemes": [
      {
        "id": "sotlas-icons",
        "label": "Sotlas File Icons",
        "path": "./icons/sotlas-icon-theme.json"
      }
    ],
    "commands": [
      {
        "command": "sotlas.build",
        "title": "Sotlas: Compilar Pacote Atual"
      },
      {
        "command": "sotlas.check",
        "title": "Sotlas: Verificar Tipos e Sintaxe"
      },
      {
        "command": "sotlas.format",
        "title": "Sotlas: Formatar Arquivo Atual"
      },
      {
        "command": "sotlas.studio",
        "title": "Sotlas: Abrir Sotlas Studio (Navegador)"
      },
      {
        "command": "sotlas.repl",
        "title": "Sotlas: Iniciar Terminal Interativo (REPL)"
      },
      {
        "command": "sotlas.dumpWasm",
        "title": "Sotlas: Emitir WebAssembly (.wat)"
      },
      {
        "command": "sotlas.restartServer",
        "title": "Sotlas: Reiniciar Servidor de Linguagem (LSP)"
      }
    ],
    "configuration": {
      "type": "object",
      "title": "Sotlas Configuration",
      "properties": {
        "sotlas.compilerPath": {
          "type": "string",
          "default": "sotlas",
          "description": "Caminho para o binário ou comando executável do compilador Sotlas"
        }
      }
    }
  },
  "dependencies": {
    "vscode-languageclient": "^8.1.0"
  },
  "devDependencies": {
    "@types/node": "^16.11.7",
    "@types/vscode": "^1.60.0",
    "typescript": "^4.5.4"
  }
}
