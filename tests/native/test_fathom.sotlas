module test::native::fathom;

struct Fathom {
    ptr: *const u8,
    length: usize
}

pub fn fathom_new(p: *const u8, len: usize) -> Fathom {
    let mut f: Fathom = 0;
    f.ptr = p;
    f.length = len;
    return f;
}

pub fn fathom_is_vacant(f: Fathom) -> bool {
    return f.length == 0;
}

pub fn fathom_count(f: Fathom) -> usize {
    return f.length;
}

pub fn fathom_at(f: Fathom, index: usize) -> u8 {
    probe index < f.length, "fathom_at out of bounds";
    let p: *const u8 = (f.ptr + index) as *const u8;
    return *p;
}

pub fn fathom_subfathom(f: Fathom, offset: usize, count: usize) -> Fathom {
    probe (offset + count) <= f.length, "fathom_subfathom out of bounds";
    let mut sub: Fathom = 0;
    sub.ptr = (f.ptr + offset) as *const u8;
    sub.length = count;
    return sub;
}

pub fn fathom_equals(a: Fathom, b: Fathom) -> bool {
    if a.length != b.length {
        return false;
    }
    let mut i: usize = 0;
    while i < a.length {
        let pa: *const u8 = (a.ptr + i) as *const u8;
        let pb: *const u8 = (b.ptr + i) as *const u8;
        if *pa != *pb {
            return false;
        }
        i = i + 1;
    }
    return true;
}

pub fn test_fathom_lifecycle_and_indexing() -> bool {
    let mut buffer: [u8; 8] = 0;
    buffer[0] = 10;
    buffer[1] = 20;
    buffer[2] = 30;
    buffer[3] = 40;
    buffer[4] = 50;
    buffer[5] = 60;
    buffer[6] = 70;
    buffer[7] = 80;

    let f: Fathom = fathom_new(buffer as *const u8, 8);
    probe !fathom_is_vacant(f), "fathom must not be vacant";
    probe fathom_count(f) == 8, "fathom count must be 8";

    probe fathom_at(f, 0) == 10, "element 0 must be 10";
    probe fathom_at(f, 3) == 40, "element 3 must be 40";
    probe fathom_at(f, 7) == 80, "element 7 must be 80";

    return true;
}

pub fn test_fathom_subwindow_and_equality() -> bool {
    let mut buf: [u8; 6] = 0;
    buf[0] = 65; // 'A'
    buf[1] = 66; // 'B'
    buf[2] = 67; // 'C'
    buf[3] = 65; // 'A'
    buf[4] = 66; // 'B'
    buf[5] = 67; // 'C'

    let f: Fathom = fathom_new(buf as *const u8, 6);
    let sub1: Fathom = fathom_subfathom(f, 0, 3);
    let sub2: Fathom = fathom_subfathom(f, 3, 3);

    probe fathom_count(sub1) == 3, "sub1 count must be 3";
    probe fathom_count(sub2) == 3, "sub2 count must be 3";

    probe fathom_equals(sub1, sub2), "both ABC subfathoms must be equal";

    let sub_diff: Fathom = fathom_subfathom(f, 1, 3); // BCD
    probe !fathom_equals(sub1, sub_diff), "ABC must not equal BCD";

    return true;
}

pub fn main() -> i32 {
    probe test_fathom_lifecycle_and_indexing(), "fathom indexing passed";
    probe test_fathom_subwindow_and_equality(), "fathom subwindow and equality passed";
    return 0;
}
