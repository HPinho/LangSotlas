module test::thread_native;

import system::thread::*;

static mut g_channel_buffer: [u64; 8] = 0;

pub fn main() -> i32 {
    // 1. Test Mutex
    let mut m: Mutex = mutex_new();
    if !mutex_try_lock(&m) {
        return 1;
    }
    // Should fail while locked
    if mutex_try_lock(&m) {
        return 2;
    }
    mutex_unlock(&m);

    // After unlock, try_lock should succeed
    if !mutex_try_lock(&m) {
        return 3;
    }
    mutex_unlock(&m);

    // 2. Test ChannelU64
    let mut ch: ChannelU64 = channel_new(g_channel_buffer as *mut u64, 4);
    if !channel_is_empty(&ch) {
        return 4;
    }

    let ok1: bool = channel_send(&ch, 111);
    let ok2: bool = channel_send(&ch, 222);
    if !ok1 || !ok2 {
        return 5;
    }
    if channel_is_empty(&ch) {
        return 6;
    }

    let mut out_val: u64 = 0;
    let r1: bool = channel_recv(&ch, &out_val as *mut u64);
    if !r1 || out_val != 111 {
        return 7;
    }

    let r2: bool = channel_recv(&ch, &out_val as *mut u64);
    if !r2 || out_val != 222 {
        return 8;
    }

    if !channel_is_empty(&ch) {
        return 9;
    }

    // 3. Test CondVar
    let mut cv: CondVar = condvar_new();
    if cv.sequence != 0 {
        return 10;
    }
    condvar_notify_one(&cv);
    if cv.sequence != 1 {
        return 11;
    }

    return 0;
}
