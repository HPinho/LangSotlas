module foundation::file;

// ----------------------------------------------------------------------------
// foundation::file — Deterministic File & Stream Descriptor
// ----------------------------------------------------------------------------
//
// In baremetal/kernel mode, handles represent raw storage device blocks / partitions.
// In hosted mode, handles map directly to POSIX/Win32 file descriptors.
// ----------------------------------------------------------------------------

pub enum FileMode {
    ReadOnly = 0,
    WriteOnly = 1,
    ReadWrite = 2,
    Append = 3
}

pub struct FileHandle {
    pub fd: i32;
    pub is_open: bool;
    pub mode: FileMode;
}

pub struct File {
    pub handle: FileHandle;
}

pub fn file_new() -> File {
    let mut f: File = 0;
    f.handle.fd = -1;
    f.handle.is_open = false;
    f.handle.mode = FileMode::ReadOnly;
    return f;
}

pub fn file_from_raw_fd(fd: i32, mode: FileMode) -> File {
    let mut f: File = 0;
    f.handle.fd = fd;
    f.handle.is_open = fd >= 0;
    f.handle.mode = mode;
    return f;
}

pub fn file_is_open(f: *const File) -> bool {
    if f == null {
        return false;
    }
    unsafe {
        return (*f).handle.is_open;
    }
}

pub fn file_raw_descriptor(f: *const File) -> i32 {
    if f == null {
        return -1;
    }
    unsafe {
        return (*f).handle.fd;
    }
}

pub fn file_close(f: *mut File) {
    if f != null {
        unsafe {
            (*f).handle.fd = -1;
            (*f).handle.is_open = false;
        }
    }
}
