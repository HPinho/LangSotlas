module foundation::alloc;

// Representação de bloco alocado na memória
pub struct MemoryBlock {
    pub ptr: *mut u8;
    pub size: usize;
    pub alignment: usize;
}

// Arena Allocator de alto desempenho para alocações contíguas em lote
pub class ArenaAllocator {
    buffer: *mut u8;
    capacity: usize;
    offset: usize;

    pub fn new(backing_buffer: *mut u8, cap: usize) -> ArenaAllocator {
        let mut arena: ArenaAllocator = 0;
        arena.buffer = backing_buffer;
        arena.capacity = cap;
        arena.offset = 0;
        return arena;
    }

    pub fn allocate(self: *mut ArenaAllocator, size: usize, align: usize) -> *mut u8 {
        if self == null {
            return null;
        }

        unsafe {
            if self.buffer == null {
                return null;
            }

            let mut alignment: usize = align;
            if alignment == 0 {
                alignment = 8;
            }

            let current: usize = (self.buffer as usize) + self.offset;
            let remainder: usize = current % alignment;
            let padding: usize = if remainder == 0 { 0 } else { alignment - remainder };

            if self.offset + padding + size > self.capacity {
                return null; // Arena cheia
            }

            self.offset = self.offset + padding;
            let result: *mut u8 = self.buffer + self.offset;
            self.offset = self.offset + size;
            return result;
        }
    }

    pub fn reset(self: *mut ArenaAllocator) {
        if self != null {
            unsafe {
                self.offset = 0;
            }
        }
    }

    pub fn bytes_used(self: *const ArenaAllocator) -> usize {
        if self == null {
            return 0;
        }
        unsafe {
            return self.offset;
        }
    }

    pub fn bytes_remaining(self: *const ArenaAllocator) -> usize {
        if self == null {
            return 0;
        }
        unsafe {
            return self.capacity - self.offset;
        }
    }
}
