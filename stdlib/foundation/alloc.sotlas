module foundation::alloc;

// ----------------------------------------------------------------------------
// foundation::alloc — Deterministic Memory Allocation Primitives
// ----------------------------------------------------------------------------
//
// Designed for three tiers:
// 1. Baremetal: operates directly on raw physical address ranges and BSS sections.
// 2. Kernel: page-frame bump allocations with zero heap fragmentation.
// 3. High-level: scratchpad arena allocations that reset in O(1).
//
// Developer note:
// "Any problem in computer science can be solved by adding another layer of indirection,
// except for the problem of too many layers of indirection."
// Here, we have zero indirection. It's a pointer and an offset. Enjoy.
// ----------------------------------------------------------------------------

pub struct MemoryBlock {
    pub ptr: *mut u8;
    pub size: usize;
    pub alignment: usize;
}

// Arena Allocator for high-performance contiguous batch allocation
pub struct ArenaAllocator {
    pub buffer: *mut u8;
    pub capacity: usize;
    pub offset: usize;
}

pub fn arena_new(backing_buffer: *mut u8, cap: usize) -> ArenaAllocator {
    let mut arena: ArenaAllocator = 0;
    arena.buffer = backing_buffer;
    arena.capacity = cap;
    arena.offset = 0;
    return arena;
}

pub fn arena_alloc(arena: *mut ArenaAllocator, size: usize, align: usize) -> *mut u8 {
    if arena == null {
        return null;
    }
    unsafe {
        if (*arena).buffer == null || size == 0 {
            return null;
        }

        let mut alignment: usize = align;
        if alignment == 0 {
            alignment = 8;
        }

        let current: usize = ((*arena).buffer as usize) + (*arena).offset;
        let remainder: usize = current % alignment;
        let mut padding: usize = 0;
        if remainder != 0 {
            padding = alignment - remainder;
        }

        if (*arena).offset + padding + size > (*arena).capacity {
            return null; // Arena is exhausted
        }

        (*arena).offset = (*arena).offset + padding;
        let result: *mut u8 = (*arena).buffer + (*arena).offset;
        (*arena).offset = (*arena).offset + size;
        return result;
    }
}

pub fn arena_reset(arena: *mut ArenaAllocator) {
    if arena != null {
        unsafe {
            (*arena).offset = 0;
        }
    }
}

pub fn arena_remaining(arena: *const ArenaAllocator) -> usize {
    if arena == null {
        return 0;
    }
    unsafe {
        if (*arena).offset >= (*arena).capacity {
            return 0;
        }
        return (*arena).capacity - (*arena).offset;
    }
}

pub fn arena_used(arena: *const ArenaAllocator) -> usize {
    if arena == null {
        return 0;
    }
    unsafe {
        return (*arena).offset;
    }
}
