module foundation::vec;

// ----------------------------------------------------------------------------
// foundation::vec — Bounded / Heapless Dynamic Array (VecU32)
// ----------------------------------------------------------------------------
//
// Systems truth:
// Dynamically reallocating vectors inside interrupt handlers or baremetal boot
// is a great way to crash your machine before the monitor even turns on.
// This vector works with caller-provided backing memory for deterministic bounds.
// ----------------------------------------------------------------------------

pub struct OptionU32 {
    pub has_value: bool;
    pub value: u32;
}

pub struct VecU32 {
    pub data: *mut u32;
    pub length: usize;
    pub cap: usize;
}

pub fn vec_new(backing_memory: *mut u32, initial_cap: usize) -> VecU32 {
    let mut v: VecU32 = 0;
    v.data = backing_memory;
    v.length = 0;
    v.cap = initial_cap;
    return v;
}

pub fn vec_len(v: *const VecU32) -> usize {
    if v == null {
        return 0;
    }
    unsafe {
        return (*v).length;
    }
}

pub fn vec_capacity(v: *const VecU32) -> usize {
    if v == null {
        return 0;
    }
    unsafe {
        return (*v).cap;
    }
}

pub fn vec_is_empty(v: *const VecU32) -> bool {
    if v == null {
        return true;
    }
    unsafe {
        return (*v).length == 0;
    }
}

pub fn vec_push(v: *mut VecU32, value: u32) -> bool {
    if v == null {
        return false;
    }
    unsafe {
        if (*v).data == null || (*v).length >= (*v).cap {
            return false;
        }
        let target: *mut u32 = (*v).data + (*v).length;
        *target = value;
        (*v).length = (*v).length + 1;
        return true;
    }
}

pub fn vec_pop(v: *mut VecU32) -> OptionU32 {
    if v == null {
        let mut opt: OptionU32 = 0;
        opt.has_value = false;
        opt.value = 0;
        return opt;
    }
    unsafe {
        if (*v).length == 0 || (*v).data == null {
            let mut opt: OptionU32 = 0;
            opt.has_value = false;
            opt.value = 0;
            return opt;
        }
        (*v).length = (*v).length - 1;
        let target: *const u32 = (*v).data + (*v).length;
        let mut opt: OptionU32 = 0;
        opt.has_value = true;
        opt.value = *target;
        return opt;
    }
}

pub fn vec_get(v: *const VecU32, index: usize) -> OptionU32 {
    if v == null {
        let mut opt: OptionU32 = 0;
        opt.has_value = false;
        opt.value = 0;
        return opt;
    }
    unsafe {
        if index >= (*v).length || (*v).data == null {
            let mut opt: OptionU32 = 0;
            opt.has_value = false;
            opt.value = 0;
            return opt;
        }
        let target: *const u32 = (*v).data + index;
        let mut opt: OptionU32 = 0;
        opt.has_value = true;
        opt.value = *target;
        return opt;
    }
}

pub fn vec_clear(v: *mut VecU32) {
    if v != null {
        unsafe {
            (*v).length = 0;
        }
    }
}
