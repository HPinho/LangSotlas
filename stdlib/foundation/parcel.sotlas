module foundation::parcel;

// ============================================================================
// Parcel — Contiguous Buffer with Small Inline Storage (Zero Heap Allocation)
// ============================================================================
//
// Sole ownership structure (`sole struct`) that embeds up to 16 bytes directly
// into its value representation. Avoids heap allocations for microkernel IPC
// messages, device driver packets, and short tokens.

pub sole struct Parcel {
    pub inline_data: [u8; 16];
    pub length: usize;
    pub capacity: usize;
    pub heap_ptr: *mut u8;

    pub fn new() -> Parcel {
        unsafe {
            return Parcel {
                inline_data: [0 as u8; 16],
                length: 0,
                capacity: 16,
                heap_ptr: null as *mut u8,
            };
        }
    }

    pub fn is_inline(self) -> bool {
        return self.heap_ptr == null;
    }

    pub fn count(self) -> usize {
        return self.length;
    }

    @system
    pub fn append(mut self, b: u8) -> Parcel {
        if self.heap_ptr == null && self.length < 16 {
            unsafe {
                let p: *mut u8 = (&mut self.inline_data[self.length]) as *mut u8;
                *p = b;
                self.length = self.length + 1;
            }
        }
        return self;
    }

    @system
    pub fn at(self, index: usize) -> u8 {
        if index >= self.length {
            unsafe {
                __builtin_trap();
            }
        }
        if self.heap_ptr == null {
            unsafe {
                let p: *const u8 = (&self.inline_data[index]) as *const u8;
                return *p;
            }
        }
        unsafe {
            let p: *const u8 = (self.heap_ptr + index) as *const u8;
            return *p;
        }
    }

    pub fn deinit(mut self) {
        if self.heap_ptr != null {
            unsafe {
                self.heap_ptr = null as *mut u8;
            }
        }
        self.length = 0;
    }
}
