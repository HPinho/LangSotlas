module core::string;

// Borrowed UTF-8 string slice (&str)
pub struct StringSlice {
    pub data: *const u8;
    pub length: usize;
}

pub fn string_from_raw(data: *const u8, len: usize) -> StringSlice {
    let mut s: StringSlice = 0;
    s.data = data;
    s.length = len;
    return s;
}

pub fn string_len(s: StringSlice) -> usize {
    return s.length;
}

pub fn string_is_empty(s: StringSlice) -> bool {
    return s.length == 0 || s.data == null;
}

pub fn string_as_bytes(s: StringSlice) -> *const u8 {
    return s.data;
}

pub fn string_char_at(s: StringSlice, index: usize) -> u8 {
    if index >= s.length || s.data == null {
        return 0;
    }
    unsafe {
        return s.data[index];
    }
}

pub fn string_equals(a: StringSlice, b: StringSlice) -> bool {
    if a.length != b.length {
        return false;
    }
    if a.length == 0 {
        return true;
    }
    if a.data == null || b.data == null {
        return false;
    }
    let mut i: usize = 0;
    unsafe {
        while i < a.length {
            if a.data[i] != b.data[i] {
                return false;
            }
            i = i + 1;
        }
    }
    return true;
}

pub fn string_compare(a: StringSlice, b: StringSlice) -> i32 {
    let mut min_len: usize = a.length;
    if b.length < min_len {
        min_len = b.length;
    }
    let mut i: usize = 0;
    unsafe {
        while i < min_len {
            if a.data[i] < b.data[i] {
                return -1;
            }
            if a.data[i] > b.data[i] {
                return 1;
            }
            i = i + 1;
        }
    }
    if a.length < b.length {
        return -1;
    }
    if a.length > b.length {
        return 1;
    }
    return 0;
}

pub fn string_slice(s: StringSlice, start: usize, end: usize) -> StringSlice {
    if s.data == null || start >= s.length || start >= end {
        return string_from_raw(null, 0);
    }
    let mut actual_end: usize = end;
    if actual_end > s.length {
        actual_end = s.length;
    }
    unsafe {
        return string_from_raw(s.data + start, actual_end - start);
    }
}

pub fn string_starts_with(s: StringSlice, prefix: StringSlice) -> bool {
    if prefix.length > s.length {
        return false;
    }
    let sub: StringSlice = string_slice(s, 0, prefix.length);
    return string_equals(sub, prefix);
}

pub fn string_ends_with(s: StringSlice, suffix: StringSlice) -> bool {
    if suffix.length > s.length {
        return false;
    }
    let start: usize = s.length - suffix.length;
    let sub: StringSlice = string_slice(s, start, s.length);
    return string_equals(sub, suffix);
}

pub fn string_find_char(s: StringSlice, ch: u8) -> i64 {
    if s.data == null {
        return -1;
    }
    let mut i: usize = 0;
    unsafe {
        while i < s.length {
            if s.data[i] == ch {
                let res: i64 = i as i64;
                return res;
            }
            i = i + 1;
        }
    }
    return -1;
}

pub fn string_trim_start(s: StringSlice) -> StringSlice {
    if s.data == null || s.length == 0 {
        return s;
    }
    let mut start: usize = 0;
    unsafe {
        while start < s.length {
            let c: u8 = s.data[start];
            if c != 32 && c != 9 && c != 10 && c != 13 {
                break;
            }
            start = start + 1;
        }
    }
    return string_slice(s, start, s.length);
}

pub fn string_trim_end(s: StringSlice) -> StringSlice {
    if s.data == null || s.length == 0 {
        return s;
    }
    let mut end: usize = s.length;
    unsafe {
        while end > 0 {
            let c: u8 = s.data[end - 1];
            if c != 32 && c != 9 && c != 10 && c != 13 {
                break;
            }
            end = end - 1;
        }
    }
    return string_slice(s, 0, end);
}

pub fn string_trim(s: StringSlice) -> StringSlice {
    return string_trim_end(string_trim_start(s));
}

// Owned, growable UTF-8 string buffer
pub struct String {
    pub data: *mut u8;
    pub length: usize;
    pub capacity: usize;
}

pub fn string_new(backing: *mut u8, cap: usize) -> String {
    let mut s: String = 0;
    s.data = backing;
    s.length = 0;
    s.capacity = cap;
    return s;
}

pub fn string_append_char(s: *mut String, ch: u8) -> bool {
    if s == null {
        return false;
    }
    unsafe {
        if (*s).data == null || (*s).length >= (*s).capacity {
            return false;
        }
        let target: *mut u8 = (*s).data + (*s).length;
        *target = ch;
        (*s).length = (*s).length + 1;
        return true;
    }
}

pub fn string_append_slice(s: *mut String, slice: StringSlice) -> bool {
    if s == null || slice.data == null || slice.length == 0 {
        return false;
    }
    unsafe {
        if (*s).data == null || (*s).length + slice.length > (*s).capacity {
            return false;
        }
        let mut i: usize = 0;
        while i < slice.length {
            let target: *mut u8 = (*s).data + ((*s).length + i);
            *target = slice.data[i];
            i = i + 1;
        }
        (*s).length = (*s).length + slice.length;
        return true;
    }
}

pub fn string_as_slice(s: *const String) -> StringSlice {
    if s == null {
        return string_from_raw(null, 0);
    }
    unsafe {
        return string_from_raw((*s).data as *const u8, (*s).length);
    }
}
