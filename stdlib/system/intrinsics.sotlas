module system::intrinsics;

// ============================================================================
// Port I/O x86_64
// ============================================================================

@system
pub fn inb(port: u16) -> u8 {
    let mut val: u8 = 0;
    unsafe {
        __asm__ volatile ("inb %1, %0" : "=a"(val) : "Nd"(port));
    }
    return val;
}

@system
pub fn outb(port: u16, val: u8) {
    unsafe {
        __asm__ volatile ("outb %0, %1" : : "a"(val), "Nd"(port));
    }
}

@system
pub fn inw(port: u16) -> u16 {
    let mut val: u16 = 0;
    unsafe {
        __asm__ volatile ("inw %1, %0" : "=a"(val) : "Nd"(port));
    }
    return val;
}

@system
pub fn outw(port: u16, val: u16) {
    unsafe {
        __asm__ volatile ("outw %0, %1" : : "a"(val), "Nd"(port));
    }
}

@system
pub fn inl(port: u16) -> u32 {
    let mut val: u32 = 0;
    unsafe {
        __asm__ volatile ("inl %1, %0" : "=a"(val) : "Nd"(port));
    }
    return val;
}

@system
pub fn outl(port: u16, val: u32) {
    unsafe {
        __asm__ volatile ("outl %0, %1" : : "a"(val), "Nd"(port));
    }
}

// ============================================================================
// Controle de interrupções e CPU
// ============================================================================

@system
pub fn cli() {
    unsafe {
        __asm__ volatile ("cli" : : : "memory");
    }
}

@system
pub fn sti() {
    unsafe {
        __asm__ volatile ("sti" : : : "memory");
    }
}

@system
pub fn hlt() {
    unsafe {
        __asm__ volatile ("hlt");
    }
}

@system
pub fn memory_barrier() {
    unsafe {
        __asm__ volatile ("" : : : "memory");
    }
}

// ============================================================================
// IRQ save/restore — Interface de primeiro nível para seções críticas
// ============================================================================
//
// Estes wrappers delegam aos intrínsecos do backend x86-64 que usam
// pushfq/popfq para salvar e restaurar o estado completo das RFLAGS,
// incluindo o Interrupt Flag (IF).
//
// PADRÃO CORRETO para seções críticas no kernel:
//
//   let flags = irq_save_disable();
//   // ... seção crítica (interrupções desabilitadas) ...
//   irq_restore(flags);
//
// Este padrão é seguro para NESTING: se as interrupções já estavam
// desabilitadas antes da chamada, irq_restore() NÃO as habilitará.
//
// NÃO use cli()/sti() diretamente — eles quebram nesting.

// Salva RFLAGS e desabilita interrupções. Retorna as flags salvas.
@system
pub fn irq_save_disable() -> u64 {
    unsafe {
        return __irq_save_disable();
    }
}

// Restaura RFLAGS salvas anteriormente, incluindo o estado de IF.
// Se as interrupções estavam habilitadas quando irq_save_disable() foi
// chamado, elas serão re-habilitadas; se estavam desabilitadas, continuarão
// desabilitadas.
@system
pub fn irq_restore(flags: u64) {
    unsafe {
        __irq_restore(flags);
    }
}

// Verifica se as interrupções estão atualmente habilitadas.
@system
pub fn interrupts_enabled() -> bool {
    unsafe {
        return __interrupts_enabled();
    }
}
