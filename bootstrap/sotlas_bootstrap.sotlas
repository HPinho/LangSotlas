module bootstrap::sotlas_lexer;

// Tipos canônicos de tokens do compilador Sotlas
pub enum TokenKind {
    Eof,
    Identifier,
    NumberLiteral,
    StringLiteral,

    // Palavras-chave
    KwLet,
    KwVar,
    KwFn,
    KwPub,
    KwUnsafe,
    KwReturn,
    KwClass,
    KwStruct,
    KwModule,
    KwImport,
    KwIf,
    KwElse,
    KwWhile,
    KwSystem,

    // Palavras-chave Proprietárias Exclusivas de Sotlas
    KwDiscern,
    KwForge,
    KwEnclave,
    KwProbe,
    KwPulse,

    // Operadores e Pontuação
    Plus,
    Minus,
    Star,
    Slash,
    Equal,
    Colon,
    SemiColon,
    Comma,
    Arrow,
    Dot,
    OpenParen,
    CloseParen,
    OpenBrace,
    CloseBrace,
    OpenBracket,
    CloseBracket
}

// Representação de posição geográfica no código fonte
pub struct Span {
    pub line: u32;
    pub col: u32;
    pub offset: usize;
    pub length: usize;
}

pub struct Token {
    pub kind: TokenKind;
    pub span: Span;
}

// Lexer nativo escrito na própria linguagem Sotlas (Sotlas in Sotlas)
pub class SotlasLexer {
    source: *const u8;
    source_len: usize;
    cursor: usize;
    current_line: u32;
    current_col: u32;

    pub fn new(src: *const u8, len: usize) -> SotlasLexer {
        let mut lexer: SotlasLexer = 0;
        lexer.source = src;
        lexer.source_len = len;
        lexer.cursor = 0;
        lexer.current_line = 1;
        lexer.current_col = 1;
        return lexer;
    }

    pub fn is_at_end(self: *const SotlasLexer) -> bool {
        if self == null {
            return true;
        }
        unsafe {
            return self.cursor >= self.source_len;
        }
    }

    pub fn peek(self: *const SotlasLexer) -> u8 {
        if self == null {
            return 0;
        }
        unsafe {
            if self.cursor >= self.source_len {
                return 0;
            }
            return *(self.source + self.cursor);
        }
    }

    pub fn advance(self: *mut SotlasLexer) -> u8 {
        if self == null {
            return 0;
        }
        unsafe {
            if self.cursor >= self.source_len {
                return 0;
            }
            let ch: u8 = *(self.source + self.cursor);
            self.cursor = self.cursor + 1;
            if ch == 10 { // '\n'
                self.current_line = self.current_line + 1;
                self.current_col = 1;
            } else {
                self.current_col = self.current_col + 1;
            }
            return ch;
        }
    }

    pub fn skip_whitespace(self: *mut SotlasLexer) {
        if self == null {
            return;
        }
        unsafe {
            while self.cursor < self.source_len {
                let c: u8 = *(self.source + self.cursor);
                if c == 32 || c == 9 || c == 13 || c == 10 { // espaço, tab, \r, \n
                    self.cursor = self.cursor + 1;
                    if c == 10 {
                        self.current_line = self.current_line + 1;
                        self.current_col = 1;
                    } else {
                        self.current_col = self.current_col + 1;
                    }
                } else if c == 47 { // possivel comentario '//'
                    if self.cursor + 1 < self.source_len {
                        let next_c: u8 = *(self.source + self.cursor + 1);
                        if next_c == 47 { // '//'
                            while self.cursor < self.source_len && *(self.source + self.cursor) != 10 {
                                self.cursor = self.cursor + 1;
                            }
                        } else {
                            return;
                        }
                    } else {
                        return;
                    }
                } else {
                    return;
                }
            }
        }
    }

    pub fn next_token(self: *mut SotlasLexer) -> Token {
        if self == null {
            return Token {
                kind: TokenKind::Eof,
                span: Span { line: 1, col: 1, offset: 0, length: 0 }
            };
        }

        unsafe {
            self.skip_whitespace();
        }

        let mut span: Span = Span {
            line: 1,
            col: 1,
            offset: 0,
            length: 1
        };

        unsafe {
            span.line = self.current_line;
            span.col = self.current_col;
            span.offset = self.cursor;

            if self.is_at_end() {
                return Token {
                    kind: TokenKind::Eof,
                    span: span
                };
            }

            let ch: u8 = self.advance();

            if ch == 40 { return Token { kind: TokenKind::OpenParen, span: span }; }
            if ch == 41 { return Token { kind: TokenKind::CloseParen, span: span }; }
            if ch == 123 { return Token { kind: TokenKind::OpenBrace, span: span }; }
            if ch == 125 { return Token { kind: TokenKind::CloseBrace, span: span }; }
            if ch == 91 { return Token { kind: TokenKind::OpenBracket, span: span }; }
            if ch == 93 { return Token { kind: TokenKind::CloseBracket, span: span }; }
            if ch == 59 { return Token { kind: TokenKind::SemiColon, span: span }; }
            if ch == 58 { return Token { kind: TokenKind::Colon, span: span }; }
            if ch == 44 { return Token { kind: TokenKind::Comma, span: span }; }
            if ch == 43 { return Token { kind: TokenKind::Plus, span: span }; }
            if ch == 42 { return Token { kind: TokenKind::Star, span: span }; }

            if ch == 45 { // '-' ou '->'
                if self.peek() == 62 { // '>'
                    self.advance();
                    span.length = 2;
                    return Token { kind: TokenKind::Arrow, span: span };
                }
                return Token { kind: TokenKind::Minus, span: span };
            }

            if ch == 61 { return Token { kind: TokenKind::Equal, span: span }; }
            if ch == 46 { return Token { kind: TokenKind::Dot, span: span }; }

            // Identificadores e Palavras-chave
            if (ch >= 97 && ch <= 122) || (ch >= 65 && ch <= 90) || ch == 95 {
                let start_offset: usize = span.offset;
                while !self.is_at_end() {
                    let p: u8 = self.peek();
                    if (p >= 97 && p <= 122) || (p >= 65 && p <= 90) || (p >= 48 && p <= 57) || p == 95 {
                        self.advance();
                    } else {
                        break;
                    }
                }
                span.length = self.cursor - start_offset;
                return Token { kind: TokenKind::Identifier, span: span };
            }

            // Literais Numéricos
            if ch >= 48 && ch <= 57 {
                let start_offset: usize = span.offset;
                while !self.is_at_end() {
                    let p: u8 = self.peek();
                    if p >= 48 && p <= 57 {
                        self.advance();
                    } else {
                        break;
                    }
                }
                span.length = self.cursor - start_offset;
                return Token { kind: TokenKind::NumberLiteral, span: span };
            }

            return Token { kind: TokenKind::Eof, span: span };
        }
    }
}
