module core::mem;

pub enum MemStatus {
    Ok = 0,
    OutOfMemory = 1,
    InvalidAlignment = 2,
    OutOfBounds = 3
}

pub const DEFAULT_PAGE_SIZE: usize = 4096;

pub struct Buffer {
    base: *mut u8;
    capacity: usize;
    used: usize;
}

pub fn zero_memory(dest: *mut u8, count: usize) -> void {
    if dest == null || count == 0 {
        return;
    }
    let mut i: usize = 0;
    unsafe {
        while i < count {
            dest[i] = 0;
            i = i + 1;
        }
    }
}

pub fn copy_memory(dest: *mut u8, src: *const u8, count: usize) -> void {
    if dest == null || src == null || count == 0 {
        return;
    }
    let mut i: usize = 0;
    unsafe {
        while i < count {
            dest[i] = src[i];
            i = i + 1;
        }
    }
}

pub fn set_memory(dest: *mut u8, byte_val: u8, count: usize) -> void {
    if dest == null || count == 0 {
        return;
    }
    let mut i: usize = 0;
    unsafe {
        while i < count {
            dest[i] = byte_val;
            i = i + 1;
        }
    }
}

pub fn compare_memory(a: *const u8, b: *const u8, count: usize) -> i32 {
    if a == b || count == 0 {
        return 0;
    }
    if a == null {
        return -1;
    }
    if b == null {
        return 1;
    }
    let mut i: usize = 0;
    unsafe {
        while i < count {
            if a[i] < b[i] {
                return -1;
            }
            if a[i] > b[i] {
                return 1;
            }
            i = i + 1;
        }
    }
    return 0;
}

pub fn get_default_page_size() -> usize {
    return DEFAULT_PAGE_SIZE;
}

pub fn remaining(capacity: usize, used: usize) -> usize {
    if used < capacity {
        return capacity - used;
    } else {
        return 0;
    }
}
